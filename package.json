{
  "name": "microsoft-harness",
  "version": "1.0.0",
  "description": "Production-grade implementation POC of the Microsoft Copilot Harness for Foundry and GitHub Copilot SDK with multi-model HydraFusion orchestration, MCP, agent skills, and bounded safety controls.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "microsoft-harness": "./bin/cli.ts"
  },
  "scripts": {
    "start": "node src/server/api.ts",
    "cli": "node bin/cli.ts",
    "test": "node --test 'tests/**/*.test.ts'",
    "test:verbose": "node --test --test-reporter spec 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "microsoft",
    "copilot-harness",
    "foundry",
    "copilot-sdk",
    "hydrafusion",
    "multi-model",
    "agent-skills",
    "mcp",
    "ai-agents"
  ],
  "author": "Karthik Ramesh",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
